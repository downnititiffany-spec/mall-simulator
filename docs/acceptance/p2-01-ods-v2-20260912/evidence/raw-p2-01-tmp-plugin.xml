        <debuggerPort implementation="int" default-value="5005">${debuggerPort}</debuggerPort>
        <fileReporterOptions implementation="java.lang.String">${fileReporterOptions}</fileReporterOptions>
        <forkMode implementation="java.lang.String" default-value="once">${forkMode}</forkMode>
        <forkedProcessTimeoutInSeconds implementation="int" default-value="0">${timeout}</forkedProcessTimeoutInSeconds>
        <jUnitClasses implementation="java.lang.String">${junitClasses}</jUnitClasses>
        <jvm implementation="java.lang.String">${jvm}</jvm>
        <logForkedProcessCommand implementation="boolean" default-value="false">${logForkedProcessCommand}</logForkedProcessCommand>
        <membersOnlySuites implementation="java.lang.String">${membersOnlySuites}</membersOnlySuites>
        <memoryFiles implementation="java.lang.String">${memoryFiles}</memoryFiles>
        <outputDirectory implementation="java.io.File">${project.build.outputDirectory}</outputDirectory>
        <parallel implementation="boolean">${parallel}</parallel>
        <project implementation="org.apache.maven.project.MavenProject" default-value="${project}"/>
        <reportingOutputDirectory implementation="java.io.File">${project.reporting.outputDirectory}</reportingOutputDirectory>
        <runpath implementation="java.lang.String">${runpath}</runpath>
        <spanScaleFactor implementation="double" default-value="1.0">${spanScaleFactor}</spanScaleFactor>
        <suffixes implementation="java.lang.String">${suffixes}</suffixes>
        <suiteSorting implementation="boolean">${suiteSorting}</suiteSorting>
        <suites implementation="java.lang.String">${suites}</suites>
        <tagsToExclude implementation="java.lang.String">${tagsToExclude}</tagsToExclude>
        <tagsToInclude implementation="java.lang.String">${tagsToInclude}</tagsToInclude>
        <testNGConfigFiles implementation="java.lang.String">${testNGXMLFiles}</testNGConfigFiles>
        <testOutputDirectory implementation="java.io.File">${project.build.testOutputDirectory}</testOutputDirectory>
        <tests implementation="java.lang.String">${tests}</tests>
        <testsFiles implementation="java.lang.String">${testsFiles}</testsFiles>
        <threadCount implementation="int">${threadCount}</threadCount>
        <wildcardSuites implementation="java.lang.String">${wildcardSuites}</wildcardSuites>
        <workingDirectory implementation="java.lang.String">${workingDirectory}</workingDirectory>
      </configuration>
