{
  "spec": "surrogate-key",
  "version": "v1",
  "status": "DRAFT-2026-09-12",
  "owner": "总控（草案由 P2-03 只读取证泳道提出，总控裁决 D-083…D-092 后落盘并逐向量独立复算）",
  "createdAt": "2026-09-12",
  "purpose": "多源接入后维度实体代理键的**唯一**派生规则：Java 与 Scala 两侧只做薄适配，逐向量对账；使同一实体在不同源、不同批次、不同时间得到同一键，且不同源的同名 id 不互相合并。",
  "statusNote": "DRAFT：**尚无任何实现读取本规格**（Scala 侧现行为 `IdCodec.scala` 的旧口径，Java 侧无实现）。冻结门槛见 contract-specs/README.md §3（结构对账测试转绿 + 总控审阅）。",
  "consumers": [
    "spark-jobs（Scala）：维度代理键派生（实施待做，排在 P2-01 落盘之后）",
    "analytics-server（Java）：源画像 `surrogate` 声明的校验与页面展示（薄适配待建）"
  ],
  "rule": {
    "scope": "维度实体代理键：user / product / category / brand / coupon。**事件粒度键 `event_id`/`behavior_id` 不在本规格范围**（D-055 唯一所有者 `DwdSql.scala:31`；D-093 明确本轮不触碰）。",
    "material": "<sourceCode>|<entity>|<normalizedRawId>",
    "injectivePrecondition": "材料对 (sourceCode, entity, rawId) 单射，前提两条：① `sourceCode` 与 `entity` 不含分隔符 `|`（sourceCode 受 source_registry 形状约束、entity 取固定枚举）；② rawId 位于**末位**且归一化后原样拼接。**未来新增任何组件前，必须先改为长度前缀编码**（否则单射性不再成立）。",
    "entityEnum": [
      "user",
      "product",
      "category",
      "brand",
      "coupon"
    ],
    "normalization": {
      "trim": "去首尾空白（Unicode 空白）",
      "case": "转大写，必须文化无关（Java `Locale.ROOT` / Scala `toUpperCase(Locale.ROOT)`）",
      "encoding": "UTF-8 字节",
      "notDoing": [
        "NFKC/NFKD 等 Unicode 归一",
        "内部空白压缩",
        "字母剥离（`U000065` 不得剥成 `650`）",
        "全角/半角转换",
        "任何 trim/大小写之外的静默纠正"
      ],
      "reason": "sourceCode 已在材料内 ⇒ 大小写归一**不会**造成跨源合并；异构源对同一实体可能给不同大小写，归一提高一致性。同时拒绝过度归一（`U 65` 与 `U65` 视为不同实体）。"
    },
    "digest": {
      "algorithm": "SHA-256",
      "input": "material 的 UTF-8 字节",
      "take": "摘要前 8 字节"
    },
    "keyValue": {
      "signBitCleared": true,
      "zeroMapsTo": 1,
      "range": "[1, 2^63-1]",
      "type": "BIGINT",
      "reason": "清符号位 ⇒ 键恒非负，不与 `-1`（unknown 哨兵，见 DwdSql 的 `COALESCE(...,-1)`）语义混淆；全零摘要（概率 ~2^-63）取 1 以免出现 0 键。"
    },
    "emptySemantics": {
      "when": "rawId 为 NULL / 空串 / 全空白 ⇒ **不生成键**（键列为 NULL）",
      "action": "记入数据质量（DQ）明细，**不进 quarantine、不丢行**（行数守恒优先）",
      "forbidden": [
        "静默映射到 0 / -1 / 任何哨兵键",
        "把多个空 id 行合并成一条"
      ]
    },
    "determinism": "同一 (sourceCode, entity, rawId) 在任何批次、任何时间、任何实现上必须得到同一键；**禁止**回退到行号、自增、时间戳、随机数。",
    "noFallback": "实现不得改材料构成、不得换摘要、不得在异常时降级。旧口径「剥字母转 BIGINT」（`IdCodec.scala`）**摧毁前缀命名空间**（`U00000001` 与 `O00000001` 都归一为 1），本规格取代之。"
  },
