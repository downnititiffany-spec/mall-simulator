      "path": "tabs.t.0.body.content[55]",
      "tabId": "t.0",
      "tabTitle": "Tab 1",
      "segmentId": null,
      "startIndex": 935,
      "endIndex": 951,
      "namedStyleType": "NORMAL_TEXT",
      "isListItem": false,
      "listId": null,
      "nestingLevel": null,
      "table": null,
      "text": "   - 现有模块无法合理容纳",
      "protectedControls": []
    },
