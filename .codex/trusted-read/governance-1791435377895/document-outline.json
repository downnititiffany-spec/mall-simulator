      "path": "tabs.t.0.body.content[49]",
      "tabId": "t.0",
      "tabTitle": "Tab 1",
      "segmentId": null,
      "startIndex": 830,
      "endIndex": 855,
      "namedStyleType": "NORMAL_TEXT",
      "isListItem": false,
      "listId": null,
      "nestingLevel": null,
      "table": null,
      "text": "   - 无法可靠分类：先放入 05_Inbox",
      "protectedControls": []
    },
