<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.graduation.analytics</groupId>
    <artifactId>analytics-server</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>
  <artifactId>platform-app</artifactId>
  <name>platform-app</name>
  <description>分析平台 Spring Boot 启动模块（R1 骨架：可独立启动，端口 8091）</description>
    <dependencies>    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-core</artifactId>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-mysql</artifactId>
    </dependency>
    <dependency>
      <groupId>com.baomidou</groupId>
      <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
      <version>${mybatis-plus.version}</version>
    </dependency>
    <dependency>
      <groupId>com.graduation.analytics</groupId>
      <artifactId>connection-ingestion</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.graduation.analytics</groupId>
      <artifactId>warehouse-pipeline</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.graduation.analytics</groupId>
      <artifactId>metric-analysis</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.graduation.analytics</groupId>
      <artifactId>ai-decision</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>
    <dependency>
      <groupId>org.projectlombok</groupId>
      <artifactId>lombok</artifactId>
      <optional>true</optional>
    </dependency>
    <!-- R8-3：身份/权限/审计的 L0 单测（不连库：Mockito 打桩，验证「身份不可伪造 + 权限矩阵 + 状态机」） -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- DEF-16：复用 platform-common 的测试工具（RepoRoot 单一所有者），
         本模块的源码策略守卫不得再写「工作目录＝模块 basedir」的相对路径 -->
    <dependency>
      <groupId>com.graduation.analytics</groupId>
      <artifactId>platform-common</artifactId>
      <version>${project.version}</version>
      <type>test-jar</type>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>